# Matches the Ubuntu/Blender environment used by the model build workflow.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LIBGL_ALWAYS_SOFTWARE=1
RUN apt-get update && apt-get install -y --no-install-recommends blender ffmpeg xvfb xauth python3 python3-venv fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY server/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY server ./server
COPY blender ./blender
COPY models/robot-prototype.blend ./models/robot-prototype.blend
EXPOSE 8080
CMD ["uvicorn","server.main:app","--host","0.0.0.0","--port","8080","--workers","1"]
